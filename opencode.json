{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "{env:OPENCODE_LARGE_MODEL}",
  "small_model": "{env:OPENCODE_TINY_MODEL}",
  "lsp": false,
  "subagent_depth": 6,
  "permission": {
    "skill": {
      "open-prs": "deny"
    },
    "external_directory": {
      "/tmp/**": "allow",
      "/dev/null": "allow",
      "/dev/stdin": "allow",
      "/dev/stdout": "allow",
      "/dev/stderr": "allow",
      "/nix/store/**": "allow",
      "/proc/**": "allow",
      "{env:HOME}/projects/**": "allow",
      "{env:HOME}/secrets/**": "allow"
    },
    "read": {
      "{env:HOME}/secrets/**": "deny"
    },
    "bash": {
      "*~/secrets*": "ask",
      "*{env:HOME}/secrets*": "ask",
      "sshpass -f ~/secrets/* *": "allow",
      "sshpass -f {env:HOME}/secrets/* *": "allow"
    },
    "edit": {
      "/nix/store/**": "deny",
      "/proc/**": "deny",
      "{env:HOME}/projects/**": "ask"
    }
  },
  "compaction": {
    "reserved": 20000,
    "prune": false
  },
  "agent": {
    "compaction": {
      "model": "{env:OPENCODE_SMALL_MODEL}"
    },
    "code-cleanup": {
      "model": "{env:OPENCODE_SMALL_MODEL}"
    },
    "build-test-summarizer": {
      "model": "{env:OPENCODE_SMALL_MODEL}"
    },
    "software-engineer": {
      "model": "{env:OPENCODE_MEDIUM_MODEL}"
    },
    "code-reviewer": {
      "model": "{env:OPENCODE_LARGE_MODEL}"
    },
    "graph-builder": {
      "model": "{env:OPENCODE_SMALL_MODEL}",
      "permission": {
        "skill": "deny"
      }
    },
    "explore": {
      "permission": {
        "skill": {
          "graphify": "allow",
          "nix-dep-investigation": "allow",
          "confluence": "allow",
          "jira": "allow",
          "web-search": "allow"
        },
        "bash": {
          "graphify-smart *": "allow"
        },
        "task": {
          "graph-builder *": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "skill": {
          "web-search": "allow"
        }
      }
    },
    "research-assistant": {
      "permission": {
        "skill": {
          "web-search": "allow"
        }
      }
    }
  },
  "mcp": {
    "lib-info": {
      "type": "local",
      "command": [
        "nix",
        "run",
        "/home/jvolante/projects/lib-info-mcp",
        "--",
        "--config",
        "/home/jvolante/.config/lib-info-mcp/config.toml"
      ],
      "timeout": 600000
    },
    "zotero": {
      "type": "local",
      "enabled": false,
      "command": [
        "nix",
        "run",
        "/home/jvolante/nix-config#zotero-mcp",
        "--",
        "serve"
      ],
      "env": {
        "ZOTERO_LOCAL": "true"
      }
    },
    "markitdown": {
      "type": "local",
      "command": [
        "nix",
        "run",
        "--impure",
        "--expr",
        "let pkgs = import (builtins.getFlake \"nixpkgs\").outPath { config.packageOverrides = pkgs: { python314 = pkgs.python314.override { packageOverrides = pyfinal: pyprev: { pandas-stubs = pyprev.pandas-stubs.overrideAttrs (o: { doInstallCheck = false; pythonImportsCheck = []; }); }; }; }; }; in pkgs.markitdown-mcp"
      ]
    }
  }
}
