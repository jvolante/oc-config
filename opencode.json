{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "model": "{env:OPENCODE_LARGE_MODEL}",
  "small_model": "{env:OPENCODE_TINY_MODEL}",
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "lua-ls": {
      "command": [
        "lua-language-server"
      ],
      "extensions": [
        ".lua"
      ]
    },
    "ruff": {
      "command": [
        "ruff",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    },
    "clangd": {
      "disabled": true,
      "command": [
        "clangd"
      ],
      "extensions": [
        ".c",
        ".h",
        ".cpp",
        ".hpp",
        ".cc",
        ".cxx",
        ".hxx",
        ".cu"
      ]
    },
    "bash": {
      "command": [
        "bash-language-server",
        "start"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".zsh",
        ".ksh"
      ]
    },
    "yaml-ls": {
      "command": [
        "yaml-language-server",
        "--stdio"
      ],
      "extensions": [
        ".yaml",
        ".yml"
      ]
    },
    "rust": {
      "command": [
        "rust-analyzer"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "marksman": {
      "command": [
        "marksman"
      ],
      "extensions": [
        ".md"
      ]
    },
    "jqls": {
      "command": [
        "jq-lsp"
      ],
      "extensions": [
        ".jq"
      ]
    },
    "jsonls": {
      "command": [
        "vscode-json-languageserver",
        "--stdio"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    },
    "glsl_analyzer": {
      "command": [
        "glsl_analyzer"
      ],
      "extensions": [
        ".glsl",
        ".vert",
        ".frag",
        ".geom",
        ".comp"
      ]
    },
    "buf_ls": {
      "command": [
        "buf",
        "lsp",
        "serve"
      ],
      "extensions": [
        ".proto"
      ]
    },
    "nixd": {
      "command": [
        "nixd"
      ],
      "extensions": [
        ".nix"
      ]
    },
    "neocmake": {
      "command": [
        "neocmakelsp"
      ],
      "extensions": [
        ".cmake",
        "CMakeLists.txt"
      ]
    },
    "taplo": {
      "command": [
        "taplo",
        "lsp",
        "stdio"
      ],
      "extensions": [
        ".toml"
      ]
    },
    "tinymist": {
      "command": [
        "tinymist"
      ],
      "extensions": [
        ".typ"
      ]
    },
    "ty": {
      "command": [
        "ty",
        "server"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  },
  "subagent_depth": 6,
  "permission": {
    "skill": {
      "open-prs": "deny",
      "librarian-store": "deny",
      "zotero": "deny"
    },
    "external_directory": {
      "/tmp/**": "allow",
      "/dev/null": "allow",
      "/dev/stdin": "allow",
      "/dev/stdout": "allow",
      "/dev/stderr": "allow",
      "/nix/store/**": "allow",
      "/proc/**": "allow",
      "{env:HOME}/projects/**": "allow",
      "{env:HOME}/secrets/**": "allow"
    },
    "read": {
      "{env:HOME}/secrets/**": "deny",
      "~/secrets/**": "deny"
    },
    "glob": {
      "{env:HOME}/secrets/**": "allow",
      "~/secrets/**": "allow"
    },
    "bash": {
      "*~/secrets*": "ask",
      "*{env:HOME}/secrets*": "ask",
      "ls * ~/secrets": "allow",
      "ls * {env:HOME}/secrets": "allow",
      "sshpass -f ~/secrets/* *": "allow",
      "sshpass -f {env:HOME}/secrets/* *": "allow"
    },
    "task": {
      "source-filer": "deny"
    },
    "edit": {
      "/nix/store/**": "deny",
      "/proc/**": "deny",
      "{env:HOME}/projects/**": "ask"
    }
  },
  "compaction": {
    "reserved": 20000,
    "prune": false
  },
  "agent": {
    "compaction": {
      "model": "{env:OPENCODE_SMALL_MODEL}"
    },
    "build-test-summarizer": {
      "model": "{env:OPENCODE_SMALL_MODEL}"
    },
    "software-engineer": {
      "model": "{env:OPENCODE_MEDIUM_MODEL}"
    },
    "code-reviewer": {
      "model": "{env:OPENCODE_LARGE_MODEL_ALT}"
    },
    "graph-builder": {
      "model": "{env:OPENCODE_SMALL_MODEL}",
      "permission": {
        "skill": "deny"
      }
    },
    "explore": {
      "model": "{env:OPENCODE_SMALL_MODEL}",
      "permission": {
        "skill": {
          "graphify": "allow",
          "nix-dep-investigation": "allow",
          "confluence": "allow",
          "jira": "allow",
          "web-search": "allow"
        },
        "bash": {
          "graphify-smart *": "allow"
        },
        "task": {
          "graph-builder *": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "skill": {
          "web-search": "allow"
        }
      }
    },
    "research-assistant": {
      "permission": {
        "skill": {
          "web-search": "allow",
          "zotero": "allow"
        }
      }
    },
    "librarian": {
      "model": "{env:OPENCODE_MEDIUM_MODEL}",
      "permission": {
        "skill": {
          "confluence": "allow",
          "librarian-store": "allow",
          "web-search": "allow",
          "zotero": "allow"
        }
      }
    },
    "source-filer": {
      "model": "{env:OPENCODE_SMALL_MODEL}"
    }
  },
  "mcp": {
    "lib-info": {
      "type": "local",
      "command": [
        "nix",
        "run",
        "/home/jvolante/projects/lib-info-mcp",
        "--",
        "--config",
        "/home/jvolante/.config/lib-info-mcp/config.toml"
      ],
      "timeout": 600000
    },
    "markitdown": {
      "type": "local",
      "command": [
        "nix",
        "run",
        "--impure",
        "--expr",
        "let pkgs = import (builtins.getFlake \"nixpkgs\").outPath { config.packageOverrides = pkgs: { python314 = pkgs.python314.override { packageOverrides = pyfinal: pyprev: { pandas-stubs = pyprev.pandas-stubs.overrideAttrs (o: { doInstallCheck = false; pythonImportsCheck = []; }); }; }; }; }; in pkgs.markitdown-mcp"
      ]
    }
  }
}
